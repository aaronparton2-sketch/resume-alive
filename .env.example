# Your Claude API key from https://console.anthropic.com (needed for the PDF upload and the chat bubble)
ANTHROPIC_API_KEY=

# Optional. Which Claude model reads the resume and answers chat questions.
# CLAUDE_MODEL=claude-opus-5-5

